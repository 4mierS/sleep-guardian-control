# Postgres. In Coolify die interne Verbindungs-URL der Datenbank-Ressource
# eintragen (Host = Servicename, nicht localhost).
DATABASE_URL=postgresql://user:pass@host:5432/guardian

# Sonst nichts. Die Handy-Oberflaeche hat keinen Zugangscode mehr — jedes
# Geraet koppelt sich per QR-Code am PC und bekommt dabei eine eigene,
# einzeln widerrufbare Sitzung.
